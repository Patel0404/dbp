# API
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Product mode — keep as "advisory" unless an operator/licensing integration is wired.
# Valid values: advisory | assisted_execution | automated_execution
PRODUCT_MODE=advisory
GLOBAL_KILL_SWITCH=false

# Compliance
DEFAULT_JURISDICTION=US-NJ

# Admin realm
# ADMIN_TOKEN=change-me

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SEC=60

# Web → API
API_URL=http://localhost:4000

# Vendor keys (unused in MVP — adapters fall back to mocks)
# THE_ODDS_API_KEY=
# SPORTSDATAIO_KEY=
# NEWS_API_KEY=
